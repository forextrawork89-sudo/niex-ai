NODE_ENV=production
PORT=3000

# ============================================================
# REJIM TANLASH — quyidagi ikkita bo'limni bo'sh qoldirsangiz,
# server avtomatik ravishda fayl/xotira rejimida ishlaydi (dev/pilot).
# To'ldirsangiz — Redis/Postgres ishlatiladi (production).
# ============================================================

# --- Redis (nonce/session/rate-limit/PIN — bir nechta instance uchun SHART) ---
REDIS_URL=

# --- PostgreSQL (secret/device — bir nechta instance uchun SHART) ---
DATABASE_URL=

# --- KMS (master key hech qachon diskda/envda emas) ---
# Bo'sh = dev rejimi (MASTER_KMS_KEY to'g'ridan-to'g'ri ishlatiladi — FAQAT PILOT UCHUN)
# aws  = AWS KMS orqali (WRAPPED_MASTER_KEY, AWS_REGION kerak)
# vault = HashiCorp Vault orqali (VAULT_ADDR, VAULT_TOKEN, VAULT_TRANSIT_KEY, WRAPPED_MASTER_KEY)
KMS_PROVIDER=

# Dev rejimi uchun: openssl rand -base64 32
MASTER_KMS_KEY=
RETIRED_KEY_RETENTION_DAYS=90

# AWS KMS rejimi uchun:
AWS_REGION=
WRAPPED_MASTER_KEY=

# Vault rejimi uchun:
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY=

# --- Admin API (faqat ota-ona ilovasining BACKEND'i, mobil ilova EMAS) ---
# openssl rand -hex 32
ADMIN_API_TOKEN=

# --- Ma'lumot papkasi (faqat fayl rejimida ishlatiladi) ---
DATA_DIR=/var/lib/niex

# --- Telegram webhook ---
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=

# --- Lokatsiya retention ---
LOCATION_RETENTION_DAYS=30
