# NIEX AI Environment Configuration Template
# Copy this file to .env or .env.local for local overrides.
# DO NOT commit real secrets or API keys to version control.

# Application Environment
NODE_ENV=development
PORT=5173

# Telegram Operational Bot (Optional for live Telegram alerts)
# Register a bot via @BotFather to receive guardian alerts & inline approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# SMS Gateway (Optional for live SMS alerts in Uzbekistan)
# Provider: Eskiz.uz / PlayMobile
ESKIZ_SMS_EMAIL=
ESKIZ_SMS_PASSWORD=

# Web Push VAPID Keys (Optional for live browser push notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@niex.uz

# Knowledge Base Cryptography
# Build-time AES encryption key for public/kb.enc
KB_ENCRYPTION_SECRET=
